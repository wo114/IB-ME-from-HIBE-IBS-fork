FooLiL3.l3_from_column_tail_bounds {n m w : ℕ} (q : ℕ) (A : Matrix (Fin n) (Fin m) (ZMod q))
  (B G : Matrix (Fin n) (Fin w) (ZMod q)) [MeasurableSpace (Option (Matrix (Fin m) (Fin w) ℤ))]
  (μ ν : MeasureTheory.Measure (Option (Matrix (Fin m) (Fin w) ℤ))) [MeasureTheory.IsProbabilityMeasure μ]
  [MeasureTheory.IsProbabilityMeasure ν] {s Q e εDel : ℝ} (hQ : ↑m * ↑w * s ^ 2 ≤ Q) (hTV : FooLiL3.TVWithin μ ν εDel)
  (hE : MeasurableSet (FooLiL3.badOutput (FooLiL3.ValidDelegation q A B G) (FooLiL3.QualityGood Q)))
  (hSupport : ν.real (FooLiL3.invalidOutput (FooLiL3.ValidDelegation q A B G)) = 0)
  (hColumnTail : ∀ (j : Fin w), ν.real (FooLiL3.someEvent (FooLiL3.columnLarge s j)) ≤ FooLiL3.tailBudget m e) :
  μ.real (FooLiL3.badOutput (FooLiL3.ValidDelegation q A B G) (FooLiL3.QualityGood Q)) ≤
    min 1 (εDel + ↑w * FooLiL3.tailBudget m e)
FooLiL3.l3_from_mass_certificates_and_marginals {n m w : ℕ} (q : ℕ) [NeZero q] (A : Matrix (Fin n) (Fin m) (ZMod q))
  (B G : Matrix (Fin n) (Fin w) (ZMod q)) (hA : Function.Surjective A.mulVec)
  [MeasurableSpace (Option (Matrix (Fin m) (Fin w) ℤ))]
  (μ ν : MeasureTheory.Measure (Option (Matrix (Fin m) (Fin w) ℤ))) [MeasureTheory.IsProbabilityMeasure μ]
  [MeasureTheory.IsProbabilityMeasure ν] {s Q e εDel : ℝ} (hs : 0 < s) (he : 0 ≤ e) (he1 : e < 1)
  (hQ : ↑m * ↑w * s ^ 2 ≤ Q) (hTV : FooLiL3.TVWithin μ ν εDel)
  (hE : MeasurableSet (FooLiL3.badOutput (FooLiL3.ValidDelegation q A B G) (FooLiL3.QualityGood Q)))
  (hSupport : ν.real (FooLiL3.invalidOutput (FooLiL3.ValidDelegation q A B G)) = 0)
  (hMass : ∀ (j : Fin w), FooLiL3.CosetMassComparison q A (fun i => B i j - G i j) s e)
  (hMarginal : ∀ (j : Fin w), FooLiL3.CosetColumnLaw q A (fun i => B i j - G i j) ⋯ s hs ν j) :
  μ.real (FooLiL3.badOutput (FooLiL3.ValidDelegation q A B G) (FooLiL3.QualityGood Q)) ≤
    min 1 (εDel + ↑w * FooLiL3.tailBudget m e)
FooLiL3.CosetMassComparison {n m : ℕ} (q : ℕ) (A : Matrix (Fin n) (Fin m) (ZMod q)) (u : Fin n → ZMod q) (s e : ℝ) :
  Prop
FooLiL3.CosetColumnLaw {n m w : ℕ} (q : ℕ) (A : Matrix (Fin n) (Fin m) (ZMod q)) (u : Fin n → ZMod q)
  (hx : Nonempty { x // FooLiL3.InCoset q A u x }) (s : ℝ) (hs : 0 < s)
  [MeasurableSpace (Option (Matrix (Fin m) (Fin w) ℤ))] (ν : MeasureTheory.Measure (Option (Matrix (Fin m) (Fin w) ℤ)))
  (j : Fin w) : Prop
FooLiL3.gaussian_tail_from_mass_comparison.{u_1} {X : Type u_1} (sqLength : X → ℝ) (m : ℕ) {s e : ℝ} (hs : 0 < s)
  (he : 0 ≤ e) (he1 : e < 1) (hsum : Summable fun x => FooLiL3.rho s (sqLength x))
  (hsum2 : Summable fun x => FooLiL3.rho (2 * s) (sqLength x)) (hz : 0 < FooLiL3.gaussianZ sqLength s)
  (hdouble : FooLiL3.gaussianZ sqLength (2 * s) ≤ 2 ^ m * ((1 + e) / (1 - e)) * FooLiL3.gaussianZ sqLength s) :
  (∑' (x : { x // ↑m * s ^ 2 ≤ sqLength x }), FooLiL3.rho s (sqLength ↑x)) / FooLiL3.gaussianZ sqLength s ≤
    FooLiL3.tailBudget m e
FooLiL3.gaussianPMF_tail_from_mass_comparison.{u_1} {X : Type u_1} [MeasurableSpace X] (sqLength : X → ℝ) (m : ℕ)
  {s e : ℝ} (hs : 0 < s) (he : 0 ≤ e) (he1 : e < 1) (hsum : Summable fun x => FooLiL3.rho s (sqLength x))
  (hsum2 : Summable fun x => FooLiL3.rho (2 * s) (sqLength x)) (hz : 0 < FooLiL3.gaussianZ sqLength s)
  (hdouble : FooLiL3.gaussianZ sqLength (2 * s) ≤ 2 ^ m * ((1 + e) / (1 - e)) * FooLiL3.gaussianZ sqLength s)
  (hE : MeasurableSet {x | ↑m * s ^ 2 ≤ sqLength x}) :
  (FooLiL3.gaussianPMF sqLength s hsum hz).toMeasure.real {x | ↑m * s ^ 2 ≤ sqLength x} ≤ FooLiL3.tailBudget m e
FooLiL3.euclideanOp_norm_le_sqrt_of_columns {m w : ℕ} (R : Matrix (Fin m) (Fin w) ℤ) {s Q : ℝ}
  (hcols : ∀ (j : Fin w), FooLiL3.colSq R j ≤ ↑m * s ^ 2) (hQ : ↑m * ↑w * s ^ 2 ≤ Q) : ‖FooLiL3.euclideanOp R‖ ≤ √Q
FooLiL3.actual_badOutput_probability_le.{u_2} {X : Type u_2} [MeasurableSpace (Option X)]
  (μ ν : MeasureTheory.Measure (Option X)) [MeasureTheory.IsProbabilityMeasure μ] [MeasureTheory.IsProbabilityMeasure ν]
  {w : ℕ} (valid good : X → Prop) (C : Fin w → Set X) {ε τ : ℝ} (hTV : FooLiL3.TVWithin μ ν ε)
  (hE : MeasurableSet (FooLiL3.badOutput valid good)) (hGood : ∀ (x : X), (∀ (j : Fin w), x ∉ C j) → good x)
  (hV : ν.real (FooLiL3.invalidOutput valid) = 0) (hC : ∀ (j : Fin w), ν.real (FooLiL3.someEvent (C j)) ≤ τ) :
  μ.real (FooLiL3.badOutput valid good) ≤ min 1 (ε + ↑w * τ)

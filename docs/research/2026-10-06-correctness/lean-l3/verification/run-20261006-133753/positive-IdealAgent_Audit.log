FooLiL3.l3_from_mass_certificates_and_product_ideal {n m w : ℕ} (q : ℕ) [NeZero q] (A : Matrix (Fin n) (Fin m) (ZMod q))
  (B G : Matrix (Fin n) (Fin w) (ZMod q)) (hA : Function.Surjective A.mulVec)
  [MeasurableSpace (Option (Matrix (Fin m) (Fin w) ℤ))] [MeasurableSingletonClass (Option (Matrix (Fin m) (Fin w) ℤ))]
  (μ : Measure (Option (Matrix (Fin m) (Fin w) ℤ))) [IsProbabilityMeasure μ] {s Q e εDel : ℝ} (hs : 0 < s) (he : 0 ≤ e)
  (he1 : e < 1) (hQ : ↑m * ↑w * s ^ 2 ≤ Q) (hTV : TVWithin μ (idealDelegationMeasure q A B G hA s hs) εDel)
  (hMass : ∀ (j : Fin w), CosetMassComparison q A (fun i => B i j - G i j) s e) :
  μ.real (badOutput (ValidDelegation q A B G) (QualityGood Q)) ≤ min 1 (εDel + ↑w * tailBudget m e)

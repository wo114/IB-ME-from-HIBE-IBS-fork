FooLiL3.tsum_phaseTerm_eq_gaussianMass {s : ℝ} (hs : 0 < s) (b : ℝ) :
  ∑' (z : ℤ), FooLiL3.phaseTerm s b z = ↑s * ↑(FooLiL2.gaussianMass s b)
FooLiL3.tsum_prod_phaseTerm_eq_gridMass (m : ℕ) {s : ℝ} (hs : 0 < s) (c : Fin m → ℝ) :
  ∑' (z : Fin m → ℤ), ∏ i, FooLiL3.phaseTerm s (c i) (z i) = ↑s ^ m * ↑(FooLiL2.gridMass m s c)
FooLiL3.prod_phaseTerm_eq_rho_mul_exp (m : ℕ) (s : ℝ) (c : Fin m → ℝ) (z : Fin m → ℤ) :
  ∏ i, FooLiL3.phaseTerm s (c i) (z i) =
    ↑(FooLiL3.rho s (∑ i, ↑(z i) ^ 2)) * Complex.exp (-2 * ↑Real.pi * Complex.I * ∑ i, ↑(c i) * ↑(z i))

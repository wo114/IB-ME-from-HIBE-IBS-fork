@master_relation_flat_surjective_of_identity_columns : ∀ {q n m w : ℕ} (A : Matrix (Fin n) (Fin m ⊕ Fin w) (ZMod q))
  (R₀ : Matrix (Fin m) (Fin w) ℤ) (G : Matrix (Fin n) (Fin w) (ZMod q)) (sel : Fin n → Fin w),
  A * (R₀.fromRows 1).map ⇑(Int.castRingHom (ZMod q)) = G →
    (∀ (i j : Fin n), G i (sel j) = if i = j then 1 else 0) →
      Function.Surjective (A.submatrix id ⇑finSumFinEquiv.symm).mulVec
@fullRowRank_liftMatrix_iff : ∀ {q n m : ℕ} (A : Matrix (Fin n) (Fin m) (ZMod q)),
  FooLiL2.Cosets.FullRowRank q (FooLiL2.Cosets.liftMatrix q A) ↔ Function.Surjective A.mulVec

@FooLiL2.l2_qary_mass_extension : ∀ {n m w : ℕ} (q : ℕ) [NeZero q] (A : Matrix (Fin n) (Fin m) ℤ)
  (B : Matrix (Fin n) (Fin w) ℤ),
  FooLiL2.Cosets.FullRowRank q A →
    ∀ {s t e : ℝ},
      0 < s →
        s ≤ t →
          w ≤ m →
            FooLiL2.dualTheta q A s ≤ e →
              0 < e →
                e ≤ 1 / 4 →
                  FooLiL2.dualTheta q (FooLiL2.Cosets.appendMatrix A B) t ≤ FooLiL2.extensionError e ∧
                    0 < FooLiL2.extensionError e ∧
                      FooLiL2.extensionError e < 1 ∧
                        FooLiL2.smoothingInf (FooLiL2.dualTheta q (FooLiL2.Cosets.appendMatrix A B))
                            (FooLiL2.extensionError e) ≤
                          t
@FooLiL2.l2_prime_rank : ∀ {n m w : ℕ} (q : ℕ) [inst : Fact (Nat.Prime q)] (A : Matrix (Fin n) (Fin m) ℤ)
  (B : Matrix (Fin n) (Fin w) ℤ),
  (FooLiL2.Cosets.modMatrix q A).rank = n →
    ∀ {s t e : ℝ},
      0 < s →
        s ≤ t →
          w ≤ m →
            FooLiL2.dualTheta q A s ≤ e →
              0 < e →
                e ≤ 1 / 4 →
                  FooLiL2.dualTheta q (FooLiL2.Cosets.appendMatrix A B) t ≤ 2 * e + e ^ 2 ∧
                    0 < 2 * e + e ^ 2 ∧
                      2 * e + e ^ 2 < 1 ∧
                        FooLiL2.smoothingInf (FooLiL2.dualTheta q (FooLiL2.Cosets.appendMatrix A B)) (2 * e + e ^ 2) ≤ t
@FooLiL2.l2_modular_matrices : ∀ {n m w : ℕ} (q : ℕ) [inst : Fact (Nat.Prime q)] (A : Matrix (Fin n) (Fin m) (ZMod q))
  (B : Matrix (Fin n) (Fin w) (ZMod q)),
  A.rank = n →
    ∀ {s t e : ℝ},
      0 < s →
        s ≤ t →
          w ≤ m →
            FooLiL2.dualTheta q (FooLiL2.Cosets.liftMatrix q A) s ≤ e →
              0 < e →
                e ≤ 1 / 4 →
                  FooLiL2.dualTheta q
                        (FooLiL2.Cosets.appendMatrix (FooLiL2.Cosets.liftMatrix q A) (FooLiL2.Cosets.liftMatrix q B))
                        t ≤
                      2 * e + e ^ 2 ∧
                    0 < 2 * e + e ^ 2 ∧
                      2 * e + e ^ 2 < 1 ∧
                        FooLiL2.smoothingInf
                            (FooLiL2.dualTheta q
                              (FooLiL2.Cosets.appendMatrix (FooLiL2.Cosets.liftMatrix q A)
                                (FooLiL2.Cosets.liftMatrix q B)))
                            (2 * e + e ^ 2) ≤
                          t
@FooLiL2.l2_smoothAt : ∀ {n m w : ℕ} (q : ℕ) [NeZero q] (A : Matrix (Fin n) (Fin m) ℤ) (B : Matrix (Fin n) (Fin w) ℤ),
  FooLiL2.Cosets.FullRowRank q A →
    ∀ {s t e : ℝ},
      0 < s →
        s ≤ t →
          w ≤ m →
            FooLiL2.dualTheta q A s ≤ e →
              0 < e → e ≤ 1 / 4 → FooLiL2.SmoothAt q (FooLiL2.Cosets.appendMatrix A B) (FooLiL2.extensionError e) t
@FooLiL2.dualTheta_eq_nonzero_tsum : ∀ {n d : ℕ} (q : ℕ) [NeZero q] (C : Matrix (Fin n) (Fin d) ℤ),
  FooLiL2.Cosets.FullRowRank q C →
    ∀ {t : ℝ},
      0 < t →
        FooLiL2.dualTheta q C t =
          ∑' (y : { y // y ∈ FooLiL2.Cosets.DualSet q C }), if ↑y = 0 then 0 else FooLiL2.gaussianWeight t ↑y
@FooLiL2.gaussianWeight_eq_euclidean : ∀ {d : ℕ} (t : ℝ) (x : Fin d → ℝ),
  FooLiL2.gaussianWeight t x = Real.exp (-Real.pi * t ^ 2 * ‖WithLp.toLp 2 x‖ ^ 2)
def FooLiL2.dualTheta : {n d : ℕ} → ℕ → Matrix (Fin n) (Fin d) ℤ → ℝ → ℝ :=
fun {n d} q C t => FooLiL2.dualMass q C t - 1
def FooLiL2.Cosets.DualSet.{u_1} : {n d : ℕ} →
  {K : Type u_1} → [Field K] → ℕ → Matrix (Fin n) (Fin d) ℤ → Set (Fin d → K) :=
fun {n d} {K} [Field K] q C =>
  {y | ∀ (x : Fin d → ℤ), FooLiL2.Cosets.InKernel q C x → ∃ k, y ⬝ᵥ FooLiL2.Cosets.intVector x = ↑k}
def FooLiL2.smoothingInf : (ℝ → ℝ) → ℝ → ℝ :=
fun theta e => sInf {t | 0 < t ∧ theta t ≤ e}
def FooLiL2.SmoothAt : {n d : ℕ} → ℕ → Matrix (Fin n) (Fin d) ℤ → ℝ → ℝ → Prop :=
fun {n d} q C e t => 0 < t ∧ FooLiL2.dualMass q C t ≤ 1 + e

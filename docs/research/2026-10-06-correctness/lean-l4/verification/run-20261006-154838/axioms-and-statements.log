@FooLiL4.l4_from_master_relation : ∀ {q n r k : ℕ} [inst : NeZero q]
  (A : Matrix (Fin n) (Fin (r + n * (k + 1))) (ZMod q)) (R₀ : Matrix (Fin r) (Fin (n * (k + 1))) ℤ)
  (B : Matrix (Fin n) (Fin (n * (k + 1))) (ZMod q))
  (hmaster :
    A * ((R₀.fromRows 1).map ⇑(Int.castRingHom (ZMod q))).submatrix (⇑finSumFinEquiv.symm) id =
      (FooLiL3.powersGadget n k 2).submatrix id ⇑finProdFinEquiv.symm)
  (u : Fin n → ZMod q) [inst_1 : MeasurableSpace (FooLiL4.SignatureOutput (r + n * (k + 1) + n * (k + 1)))]
  [MeasurableSingletonClass (FooLiL4.SignatureOutput (r + n * (k + 1) + n * (k + 1)))]
  (μ : MeasureTheory.Measure (FooLiL4.SignatureOutput (r + n * (k + 1) + n * (k + 1))))
  [MeasureTheory.IsProbabilityMeasure μ] {s t e εSP : ℝ} (hs : 0 < s) (hst : s ≤ t),
  0 < e →
    e ≤ 1 / 4 →
      FooLiL2.dualTheta q (FooLiL2.Cosets.liftMatrix q A) s ≤ e →
        FooLiL3.TVWithin μ
            (FooLiL4.idealSignatureMeasure q
              (FooLiL2.Cosets.modMatrix q
                (FooLiL2.Cosets.appendMatrix (FooLiL2.Cosets.liftMatrix q A) (FooLiL2.Cosets.liftMatrix q B)))
              ⋯ u t ⋯)
            εSP →
          μ.real
              (FooLiL4.signatureFailure q
                (FooLiL2.Cosets.modMatrix q
                  (FooLiL2.Cosets.appendMatrix (FooLiL2.Cosets.liftMatrix q A) (FooLiL2.Cosets.liftMatrix q B)))
                u t) ≤
            min 1 (εSP + FooLiL3.tailBudget (r + n * (k + 1) + n * (k + 1)) (2 * e + e ^ 2))
@FooLiL4.l4_from_c2_c4 : ∀ {n m w : ℕ} (q : ℕ) [inst : NeZero q] (A : Matrix (Fin n) (Fin m) ℤ)
  (B : Matrix (Fin n) (Fin w) ℤ) (hA : FooLiL2.Cosets.FullRowRank q A) (u : Fin n → ZMod q)
  [inst_1 : MeasurableSpace (FooLiL4.SignatureOutput (m + w))]
  [MeasurableSingletonClass (FooLiL4.SignatureOutput (m + w))]
  (μ : MeasureTheory.Measure (FooLiL4.SignatureOutput (m + w))) [MeasureTheory.IsProbabilityMeasure μ] {s t e εSP : ℝ}
  (hs : 0 < s) (hst : s ≤ t),
  w ≤ m →
    0 < e →
      e ≤ 1 / 4 →
        FooLiL2.dualTheta q A s ≤ e →
          FooLiL3.TVWithin μ
              (FooLiL4.idealSignatureMeasure q (FooLiL2.Cosets.modMatrix q (FooLiL2.Cosets.appendMatrix A B)) ⋯ u t ⋯)
              εSP →
            μ.real (FooLiL4.signatureFailure q (FooLiL2.Cosets.modMatrix q (FooLiL2.Cosets.appendMatrix A B)) u t) ≤
              min 1 (εSP + FooLiL3.tailBudget (m + w) (2 * e + e ^ 2))
@FooLiL4.l4_for_uniform_tape_program : ∀ {n m w L : ℕ} (q : ℕ) [inst : NeZero q] (A : Matrix (Fin n) (Fin m) ℤ)
  (B : Matrix (Fin n) (Fin w) ℤ) (hA : FooLiL2.Cosets.FullRowRank q A) (u : Fin n → ZMod q)
  [inst_1 : MeasurableSpace (FooLiL4.SignatureOutput (m + w))]
  [MeasurableSingletonClass (FooLiL4.SignatureOutput (m + w))]
  (program : FooLiL4.ByteTape L → FooLiL4.SignatureOutput (m + w)) {s t e εSP : ℝ} (hs : 0 < s) (hst : s ≤ t),
  w ≤ m →
    0 < e →
      e ≤ 1 / 4 →
        FooLiL2.dualTheta q A s ≤ e →
          FooLiL3.TVWithin (FooLiL4.rawTapeMeasure program)
              (FooLiL4.idealSignatureMeasure q (FooLiL2.Cosets.modMatrix q (FooLiL2.Cosets.appendMatrix A B)) ⋯ u t ⋯)
              εSP →
            (FooLiL4.rawTapeMeasure program).real
                (FooLiL4.signatureFailure q (FooLiL2.Cosets.modMatrix q (FooLiL2.Cosets.appendMatrix A B)) u t) ≤
              min 1 (εSP + FooLiL3.tailBudget (m + w) (2 * e + e ^ 2))
@FooLiL4.rawTapeMeasure_event : ∀ {L D : ℕ} [inst : MeasurableSpace (FooLiL4.SignatureOutput D)]
  [MeasurableSingletonClass (FooLiL4.SignatureOutput D)] (program : FooLiL4.ByteTape L → FooLiL4.SignatureOutput D)
  (E : Set (FooLiL4.SignatureOutput D)),
  (FooLiL4.rawTapeMeasure program).real E =
    ((PMF.uniformOfFintype (FooLiL4.ByteTape L)).toOuterMeasure (program ⁻¹' E)).toReal
@FooLiL4.idealSignature_failure_le : ∀ {n D : ℕ} (q : ℕ) [inst : NeZero q] (F : Matrix (Fin n) (Fin D) (ZMod q))
  (hF : Function.Surjective F.mulVec) (u : Fin n → ZMod q) {t e : ℝ} (ht : 0 < t),
  0 ≤ e →
    e < 1 →
      ∀ [inst_1 : MeasurableSpace (FooLiL4.SignatureOutput D)] [MeasurableSingletonClass (FooLiL4.SignatureOutput D)],
        FooLiL3.CosetMassComparison q F u t e →
          (FooLiL4.idealSignatureMeasure q F hF u t ht).real (FooLiL4.signatureFailure q F u t) ≤ FooLiL3.tailBudget D e
@FooLiL3.l3_from_c2_c3 : ∀ {q n r k : ℕ} [inst : NeZero q] (A : Matrix (Fin n) (Fin (r + n * (k + 1))) (ZMod q))
  (R₀ : Matrix (Fin r) (Fin (n * (k + 1))) ℤ) (B : Matrix (Fin n) (Fin (n * (k + 1))) (ZMod q))
  (hmaster :
    A * ((R₀.fromRows 1).map ⇑(Int.castRingHom (ZMod q))).submatrix (⇑finSumFinEquiv.symm) id =
      (FooLiL3.powersGadget n k 2).submatrix id ⇑finProdFinEquiv.symm)
  [inst_1 : MeasurableSpace (Option (Matrix (Fin (r + n * (k + 1))) (Fin (n * (k + 1))) ℤ))]
  [MeasurableSingletonClass (Option (Matrix (Fin (r + n * (k + 1))) (Fin (n * (k + 1))) ℤ))]
  (μ : MeasureTheory.Measure (Option (Matrix (Fin (r + n * (k + 1))) (Fin (n * (k + 1))) ℤ)))
  [MeasureTheory.IsProbabilityMeasure μ] {s Q e εDel : ℝ} (hs : 0 < s),
  0 ≤ e →
    e < 1 →
      FooLiL2.dualTheta q (FooLiL2.Cosets.liftMatrix q A) s ≤ e →
        ↑(r + n * (k + 1)) * ↑(n * (k + 1)) * s ^ 2 ≤ Q →
          FooLiL3.TVWithin μ
              (FooLiL3.idealDelegationMeasure q A B ((FooLiL3.powersGadget n k 2).submatrix id ⇑finProdFinEquiv.symm) ⋯
                s hs)
              εDel →
            μ.real
                (FooLiL3.badOutput
                  (FooLiL3.ValidDelegation q A B ((FooLiL3.powersGadget n k 2).submatrix id ⇑finProdFinEquiv.symm))
                  (FooLiL3.QualityGood Q)) ≤
              min 1 (εDel + ↑(n * (k + 1)) * FooLiL3.tailBudget (r + n * (k + 1)) e)
@FooLiL3.l3_from_smoothing_and_product_ideal : ∀ {n m w : ℕ} (q : ℕ) [inst : NeZero q]
  (A : Matrix (Fin n) (Fin m) (ZMod q)) (B G : Matrix (Fin n) (Fin w) (ZMod q)) (hA : Function.Surjective A.mulVec)
  [inst_1 : MeasurableSpace (Option (Matrix (Fin m) (Fin w) ℤ))]
  [MeasurableSingletonClass (Option (Matrix (Fin m) (Fin w) ℤ))]
  (μ : MeasureTheory.Measure (Option (Matrix (Fin m) (Fin w) ℤ))) [MeasureTheory.IsProbabilityMeasure μ]
  {s Q e εDel : ℝ} (hs : 0 < s),
  0 ≤ e →
    e < 1 →
      FooLiL2.dualTheta q (FooLiL2.Cosets.liftMatrix q A) s ≤ e →
        ↑m * ↑w * s ^ 2 ≤ Q →
          FooLiL3.TVWithin μ (FooLiL3.idealDelegationMeasure q A B G hA s hs) εDel →
            μ.real (FooLiL3.badOutput (FooLiL3.ValidDelegation q A B G) (FooLiL3.QualityGood Q)) ≤
              min 1 (εDel + ↑w * FooLiL3.tailBudget m e)
@FooLiL3.cosetMassComparison_of_smoothing : ∀ {n m : ℕ} (q : ℕ) [NeZero q] (A : Matrix (Fin n) (Fin m) (ZMod q)),
  Function.Surjective A.mulVec →
    ∀ (u : Fin n → ZMod q) {s e : ℝ},
      0 < s →
        0 ≤ e →
          e < 1 → FooLiL2.dualTheta q (FooLiL2.Cosets.liftMatrix q A) s ≤ e → FooLiL3.CosetMassComparison q A u s e
@FooLiL3.normalized_coset_mass_deviation : ∀ {n m : ℕ} (q : ℕ) [NeZero q] (C : Matrix (Fin n) (Fin m) ℤ),
  FooLiL2.Cosets.FullRowRank q C →
    ∀ (u : Fin n → ZMod q) {s : ℝ},
      0 < s → |FooLiL3.gaussianZ (fun x => FooLiL3.vectorSq ↑x) s / (s ^ m / ↑q ^ n) - 1| ≤ FooLiL2.dualTheta q C s
@FooLiL3.coset_poisson : ∀ {n m : ℕ} (q : ℕ) [inst : NeZero q] (C : Matrix (Fin n) (Fin m) ℤ) (u : Fin n → ZMod q)
  {s : ℝ},
  0 < s →
    ↑(FooLiL3.gaussianZ (fun x => FooLiL3.vectorSq ↑x) s) =
      ↑s ^ m / ↑q ^ n * ∑ a, ZMod.stdAddChar (u ⬝ᵥ a) * ↑(FooLiL2.gridMass m s (FooLiL2.residueShift q C a))
@FooLiL3.idealDelegationMeasure_rectangle : ∀ {n m w : ℕ} (q : ℕ) [inst : NeZero q]
  (A : Matrix (Fin n) (Fin m) (ZMod q)) (B G : Matrix (Fin n) (Fin w) (ZMod q)) (hA : Function.Surjective A.mulVec)
  (s : ℝ) (hs : 0 < s) [inst_1 : MeasurableSpace (Option (Matrix (Fin m) (Fin w) ℤ))]
  [MeasurableSingletonClass (Option (Matrix (Fin m) (Fin w) ℤ))] (S : Fin w → Set (Fin m → ℤ)),
  (FooLiL3.idealDelegationMeasure q A B G hA s hs) (FooLiL3.someEvent {R | ∀ (j : Fin w), (fun i => R i j) ∈ S j}) =
    ∏ j, (FooLiL3.cosetGaussian q A (fun i => B i j - G i j) ⋯ s hs).toOuterMeasure {x | ↑x ∈ S j}
